# Host dependencies/build output must never replace the Linux artifacts.
**/node_modules
**/.next
**/.pnpm-store
out
build
dist
coverage
.git
.claude
.mcp.json
# No environment files or deployment credentials in the build context.
**/.env*
**/*.pem
**/*.key
**/.npmrc
**/*debug.log*
.DS_Store
*.tsbuildinfo

# Generated by next-pwa during the production build.
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/worker-*.js
/public/worker-*.js.map
